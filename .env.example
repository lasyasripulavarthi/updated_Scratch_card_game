# Example environment variables for Nutri Delight scratch game
# Copy to .env and update values before running locally or on deployment

# JWT secret used to sign admin tokens (change in production)
JWT_SECRET=change_this_secret

# Vercel environment flag (set automatically on Vercel)
# VERCEL=1

# If using Vercel Blob storage to persist state, set a write token
# BLOB_READ_WRITE_TOKEN=<your_vercel_blob_write_token>
# or
# VERCEL_BLOB_READ_WRITE_TOKEN=<your_vercel_blob_write_token>

# PORT the app should listen on (optional locally)
# PORT=3000
